# ---------------------------------------------------------------------------
# Banco de dados — Supabase Postgres (produção e dev)
# ---------------------------------------------------------------------------
# Conexão direta ao Postgres do projeto (Supabase → Project Settings →
# Database → Connection string → aba "Direct connection"). Funciona para
# runtime e para o Prisma CLI (migrations) — é o que usamos aqui, e a mesma
# string serve para as duas variáveis.
#
# Exige IPv6 (ou o add-on de IPv4 dedicado da Supabase) na rede de quem
# conecta. Confirmado funcionando neste projeto tanto localmente quanto —
# verifique antes do deploy — a partir do host do EasyPanel. Se o host de
# produção não tiver IPv6, troque as duas por uma connection string do
# "Session pooler" (mesma tela, porta 5432, host
# postgres.<project-ref>@<região>.pooler.supabase.com) — funciona igual,
# sem exigir IPv6, e não muda nada no código.
DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
#
# Alternativa só para desenvolvimento local sem depender da Supabase: suba
# `docker compose up -d` (Postgres local) e aponte as duas variáveis acima
# para postgresql://plat_delivery:plat_delivery@localhost:5432/plat_delivery
# — não é o caminho padrão, é só uma opção.

# ---------------------------------------------------------------------------
# Autenticação (Auth.js)
# ---------------------------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="gerar-um-segredo-aleatorio"

# ---------------------------------------------------------------------------
# Evolution API (WhatsApp) — opcional até a integração ser construída
# ---------------------------------------------------------------------------
# URL base da sua instância da Evolution API e a API key global/admin usada
# para criar e gerenciar instâncias (uma por restaurante).
EVOLUTION_API_URL="https://sua-evolution-api.exemplo.com"
EVOLUTION_API_KEY="chave-admin-da-evolution-api"
# Segredo próprio (gerado por você, não vem da Evolution API) usado para
# validar as chamadas de webhook recebidas em /api/webhooks/evolution/[token]
# — configure a Evolution API para enviar o webhook para uma URL contendo
# este mesmo valor.
EVOLUTION_WEBHOOK_SECRET="gerar-um-segredo-aleatorio"
#
# URL pública deste app (sem barra final), usada para montar a webhook URL
# passada à Evolution API ao criar uma instância. Sem ela, o botão "Conectar
# WhatsApp" mostra um erro em vez de cadastrar um webhook que a Evolution API
# não conseguiria alcançar (ex.: localhost não é alcançável de fora).
APP_URL="https://seu-dominio.com"
