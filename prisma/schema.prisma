generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Tenancy & identity ----------

model Restaurant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  phone         String?
  address       String?
  timezone      String   @default("America/Sao_Paulo")
  pixKey        String?
  openingHours  Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ---------- Atendimento IA (WhatsApp agent) settings ----------
  // All additive/optional-or-defaulted so existing restaurants are
  // unaffected until an owner explicitly configures them. `aiEnabled`
  // defaults to false on purpose — the agent never turns itself on.
  aiEnabled              Boolean        @default(false)
  faqText                String?        @db.Text
  /// Freeform, descriptive only — no delivery-area enforcement exists yet.
  /// The AI can quote this when asked "do you deliver in X?", but nothing
  /// blocks an order based on it (see briefing: prepare the architecture,
  /// don't invent enforcement rules).
  deliveryAreasText      String?        @db.Text
  defaultDeliveryFee     Decimal?       @db.Decimal(10, 2)
  acceptedPaymentMethods PaymentMethod[] @default([PIX, CARTAO, DINHEIRO, VALE_REFEICAO])
  menuPdfBase64          String?        @db.Text
  menuPdfFileName        String?
  menuPdfUpdatedAt       DateTime?

  // ---------- Real-time order notifications ----------
  /// Whether the notification chime plays when a new order arrives (both
  /// WhatsApp and manual). Defaults to on — never surprises a restaurant by
  /// silently disabling something they'd expect. Purely a client-side
  /// playback toggle; doesn't affect whether the order itself is created.
  orderSoundEnabled Boolean @default(true)

  // ---------- Recepcionista de IA por telefone (ElevenLabs + Twilio) ----------
  // Same "additive, off by default" shape as the WhatsApp agent settings
  // above — an existing restaurant is unaffected until an owner explicitly
  // turns this on. The Twilio number itself is provisioned outside this
  // platform (regulatory verification for a Brazilian number is done
  // directly with Twilio) — phoneAgentTwilioNumber just records which
  // number was linked, for display in Configurações.
  phoneAgentEnabled             Boolean @default(false)
  phoneAgentElevenLabsAgentId   String?
  phoneAgentTwilioNumber        String?
  /// Where transfer_to_number (ElevenLabs' built-in system tool) sends the
  /// call when the AI hands off to a human — a staff member's real phone.
  phoneAgentHumanTransferNumber String?
  /// Which domain the phone agent runs — PEDIDO (food ordering, the
  /// original/default behavior — Casa Bonfim and any existing tenant stays
  /// on this automatically) or ATENDIMENTO_GENERICO (Agente 2 — scheduling/
  /// FAQ/lead qualification for a generic service business). Decides which
  /// module builds that call's prompt in the "iniciar" webhook — never
  /// checked by the tool-call webhook, since tool names are already
  /// unambiguous per domain.
  phoneAgentDomain              PhoneAgentDomain @default(PEDIDO)
  /// FAQ text for the generic-attendance domain — embedded directly as
  /// prompt context, same pattern as faqText/aiEnabled's faqText for the
  /// WhatsApp agent (never a callable tool).
  faqGenericoText               String?          @db.Text
  /// Base-price service list for the generic-attendance domain — shown to
  /// the caller only as an estimate, never a closed quote (same discipline
  /// as priceOrderItems: no price is ever finalized by the AI alone).
  servicosGenericosJson         Json?

  // ---------- Agente de avaliações no Google (Agente 1 — produto separado,
  // mesmo backend; ver AGENTS.md) ----------
  // Same additive/off-by-default shape as the other agent feature flags.
  // A single Google account (agency model) manages every tenant's
  // locations, so the OAuth credentials themselves live in env vars, not
  // per-tenant — reviewAgentGoogleLocationId is what selects which
  // location's reviews belong to this tenant.
  reviewAgentEnabled          Boolean @default(false)
  reviewAgentGoogleLocationId String?
  reviewAgentTomDeVoz         String? @db.Text
  /// The owner's own WhatsApp — where a negative-review draft is sent for
  /// approval before anything is ever published on their behalf.
  reviewAgentOwnerPhone       String?
  /// The direct "write a review" link (Google Maps share link) sent to
  /// customers when a review is requested. Not derived from
  /// reviewAgentGoogleLocationId — the Business Profile API's location id
  /// and the Google Maps Place ID used in that public link are different
  /// identifiers, so the owner just pastes their own share link (a 10-second
  /// one-time setup from the Google Maps app) instead of this platform
  /// needing a second API/identifier just to construct it.
  reviewAgentReviewLink       String?

  // ---------- Domínio do agente de WhatsApp (texto) ----------
  // Decides which conversational pipeline an inbound WhatsApp text message
  // goes to — PEDIDO (food ordering, the original/default behavior — any
  // existing tenant stays on this automatically), DESPACHO (Agente 3), or
  // ORCAMENTO (Agente 4). Mutually exclusive by construction: a tenant is
  // never more than one kind of business at a time. Started as a boolean
  // (despachoAgentEnabled) when only 2 states existed; generalized to an
  // enum here, mirroring PhoneAgentDomain on the voice channel, before a
  // 3rd/4th agent could force an awkward boolean-per-agent shape. Safe to
  // change now (not a data migration on real usage) — the Agente 3 field
  // this replaces was never deployed.
  whatsappAgentDomain WhatsappAgentDomain @default(PEDIDO)

  // ---------- Agente 3 — despacho de serviços residenciais emergenciais ----------
  /// Minutes to wait for a technician's accept/decline before offering the
  /// call to the next available one — a tenant field (not a hardcoded
  /// constant) so different service businesses can tune their own urgency
  /// window.
  despachoOfertaTimeoutMinutos Int    @default(5)
  /// Where the "no technician accepted"/"no technician available" alert is
  /// sent — same gap as reviewAgentOwnerPhone in Agente 1: without this
  /// there's no one to notify when automatic dispatch can't resolve a chamado.
  despachoEscalationPhone     String?

  // ---------- Agente 4 — motor de orçamento automático (cotação) ----------
  // No separate quoteAgentEnabled flag — whatsappAgentDomain === ORCAMENTO
  // is itself the on/off switch (same lesson just applied by removing
  // despachoAgentEnabled above: a domain enum only needs ONE selector, not
  // a companion boolean per agent).
  /// Descriptive only (e.g. "jardinagem") — sets conversation tone, never
  /// gates which questions get asked. The questions themselves come from
  /// whichever PricingRule rows the tenant has configured (see
  /// src/server/actions/orcamento-ia-conversa.ts) — hardcoding 4 fixed
  /// question flows per nicho would contradict the single-configurable-
  /// engine differentiation this agent exists for (see the spec's own
  /// seção 2).
  quoteAgentNicho   String?
  /// Days with no reply before the automatic follow-up fires — tenant field,
  /// not a hardcoded constant (confirmed default: 2 days).
  quoteFollowUpDias Int     @default(2)
  /// How many days a sent quote stays valid before expiring automatically —
  /// not specified as a number in the spec ("prazo de validade"); a sensible
  /// tenant-configurable default, adjustable in Configurações without a
  /// deploy.
  quoteValidadeDias Int     @default(7)

  // ---------- Agente 5 — locação autônoma para pequenas imobiliárias ----------
  // No separate locacaoAgentEnabled flag either — whatsappAgentDomain ===
  // LOCACAO is itself the on/off switch (same reasoning as Agentes 3/4).
  /// Minutes blocked around an already-booked visit for the same corretor —
  /// not specified as a number in the spec; confirmed default with the
  /// user. Tenant-configurable, adjustable without a deploy.
  locacaoVisitaDuracaoMin Int @default(30)

  users          User[]
  customers      Customer[]
  categories     Category[]
  products       Product[]
  orders         Order[]
  stockItems     StockItem[]
  financialEntries FinancialEntry[]
  whatsappConnection WhatsappConnection?
  conversations  Conversation[]
  feedbacks      Feedback[]
  phoneCalls     PhoneCall[]
  reviews             Review[]
  reviewRequestLogs   ReviewRequestLog[]
  horariosDisponiveis HorarioDisponivel[]
  callbackRequests    CallbackRequest[]
  tecnicos            TecnicoDisponibilidade[]
  chamados            Chamado[]
  pricingRules        PricingRule[]
  quotes              Quote[]
  corretores          Corretor[]
  imoveis             Imovel[]
  candidaturas        Candidatura[]
}

enum WhatsappAgentDomain {
  PEDIDO
  DESPACHO
  ORCAMENTO
  LOCACAO
}

enum PhoneAgentDomain {
  PEDIDO
  ATENDIMENTO_GENERICO
}

enum Role {
  OWNER
  ADMIN
  ATTENDANT
  KITCHEN
}

model User {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ATTENDANT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// ---------- Customers ----------

model Customer {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  /// Optional — a walk-in customer created manually may have only a name.
  /// The @@unique below stays safe with this: Postgres treats multiple NULLs
  /// as distinct, so several no-phone customers can coexist per restaurant.
  phone        String?
  address      String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders        Order[]
  conversations Conversation[]
  feedbacks     Feedback[]
  phoneCalls    PhoneCall[]
  chamados      Chamado[]
  quotes        Quote[]
  candidaturas  Candidatura[]

  @@index([restaurantId])
  @@unique([restaurantId, phone])
}

// ---------- Menu ----------

model Category {
  id           String @id @default(cuid())
  restaurantId String
  name         String
  position     Int    @default(0)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@index([restaurantId])
}

model Product {
  id           String   @id @default(cuid())
  restaurantId String
  categoryId   String
  name         String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  imageUrl     String?
  isAvailable  Boolean  @default(true)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id])
  optionGroups OptionGroup[]
  orderItems   OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
}

model OptionGroup {
  id        String  @id @default(cuid())
  productId String
  name      String
  required  Boolean @default(false)
  multiple  Boolean @default(false)

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   OptionItem[]

  @@index([productId])
}

model OptionItem {
  id      String  @id @default(cuid())
  groupId String
  name    String
  price   Decimal @db.Decimal(10, 2) @default(0)

  group             OptionGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItemOptions  OrderItemOption[]

  @@index([groupId])
}

// ---------- Orders ----------

enum OrderStatus {
  NOVO
  AGUARDANDO_PAGAMENTO
  CONFIRMADO
  EM_PREPARO
  PRONTO
  EM_ENTREGA
  CONCLUIDO
  CANCELADO
}

enum OrderChannel {
  CARDAPIO_PROPRIO
  MARKETPLACE
  WHATSAPP_IA
  /// Pedido manual anotado por um atendente humano ao telefone — não confundir
  /// com TELEFONE_IA (a recepcionista de IA por telefone), abaixo.
  TELEFONE
  TELEFONE_IA
  BALCAO
}

enum Fulfillment {
  DELIVERY
  RETIRADA
}

enum PaymentMethod {
  PIX
  CARTAO
  DINHEIRO
  VALE_REFEICAO
}

/// PENDENTE and PAGO predate the WhatsApp payment flow and keep their exact
/// prior meaning ("aguardando pagamento" / "pago") — the 3 new values are
/// additive, inferred automatically for WhatsApp orders (see confirmar_pedido
/// in atendimento-ia-conversa.ts). Manual orders created by staff
/// (createManualOrder) never use the new values — they always know
/// PENDENTE/PAGO directly.
enum PaymentStatus {
  PENDENTE
  PAGO
  AGUARDANDO_CONFIRMACAO_PIX
  PAGAMENTO_NA_ENTREGA
  PAGAMENTO_NA_RETIRADA
}

model Order {
  id            String        @id @default(cuid())
  restaurantId  String
  customerId    String?
  number        Int
  status        OrderStatus   @default(NOVO)
  channel       OrderChannel
  fulfillment   Fulfillment
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDENTE)
  address       String?
  notes         String?
  /// Optional — filled in only when a staff member cancels with a reason.
  cancelReason  String?
  /// One-off name for this order only, when it differs from the customer's
  /// registered name (e.g. "pode colocar outro nome nesse pedido") — never
  /// overwrites Customer.name. Null means "use the customer's name as-is".
  customerNameOverride String?
  /// Pix proof of payment, sent by the customer as a WhatsApp image —
  /// same base64-in-Postgres pattern as Restaurant.menuPdfBase64/
  /// WhatsappConnection.qrCode. Receiving this never marks the order paid by
  /// itself; a staff member confirms via confirmPayment (src/server/actions/orders.ts).
  pixProofBase64     String?   @db.Text
  pixProofMimeType   String?
  pixProofReceivedAt DateTime?
  subtotal      Decimal       @db.Decimal(10, 2)
  deliveryFee   Decimal       @db.Decimal(10, 2) @default(0)
  total         Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer?    @relation(fields: [customerId], references: [id])
  items      OrderItem[]
  events     OrderEvent[]
  feedback   Feedback?
  phoneCall  PhoneCall?

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@unique([restaurantId, number])
}

/// One row per status transition. Lets us compute real operational metrics
/// (time in preparo, time in entrega, % above the promised time) instead of
/// hardcoding them — recorded automatically whenever an order's status
/// changes (see src/server/actions/orders.ts).
model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  notes     String?

  order   Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product            @relation(fields: [productId], references: [id])
  options OrderItemOption[]

  @@index([orderId])
}

model OrderItemOption {
  id          String  @id @default(cuid())
  orderItemId String
  optionItemId String
  price       Decimal @db.Decimal(10, 2)

  orderItem  OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  optionItem OptionItem @relation(fields: [optionItemId], references: [id])

  @@index([orderItemId])
}

// ---------- Stock ----------

enum StockMovementType {
  ENTRADA
  SAIDA
}

model StockItem {
  id            String   @id @default(cuid())
  restaurantId  String
  name          String
  unit          String
  quantityOnHand Decimal @db.Decimal(10, 2) @default(0)
  minQuantity   Decimal  @db.Decimal(10, 2) @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  movements  StockMovement[]

  @@index([restaurantId])
}

model StockMovement {
  id          String            @id @default(cuid())
  stockItemId String
  type        StockMovementType
  quantity    Decimal           @db.Decimal(10, 2)
  reason      String?
  createdAt   DateTime          @default(now())

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([stockItemId])
}

// ---------- Financial ----------

enum FinancialEntryType {
  RECEITA
  DESPESA
}

model FinancialEntry {
  id           String             @id @default(cuid())
  restaurantId String
  type         FinancialEntryType
  category     String
  amount       Decimal            @db.Decimal(10, 2)
  description  String?
  date         DateTime
  createdAt    DateTime           @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, date])
}

// ---------- WhatsApp (Evolution API) ----------
//
// Foundation only — no agent/UI wired up yet (see
// src/server/integrations/evolution/ and
// src/app/api/webhooks/evolution/[token]/route.ts). Each restaurant maps to
// exactly one Evolution API instance, identified by `instanceName`; inbound
// webhooks resolve the restaurant through that mapping, which is how the
// integration stays isolated per tenant.

enum WhatsappConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  ERROR
}

model WhatsappConnection {
  id           String                   @id @default(cuid())
  restaurantId String                   @unique
  instanceName String                   @unique
  status       WhatsappConnectionStatus @default(DISCONNECTED)
  qrCode       String? // cached base64 QR while status = CONNECTING
  phoneNumber  String?
  lastEventAt  DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

/// Raw log of inbound Evolution API webhook calls. restaurantId/instanceName
/// are nullable because an event for an unrecognized instance is still
/// recorded (for debugging) rather than dropped silently.
model WhatsappWebhookEvent {
  id           String   @id @default(cuid())
  restaurantId String?
  instanceName String?
  eventType    String
  payload      Json
  createdAt    DateTime @default(now())

  @@index([restaurantId])
  @@index([createdAt])
}

// ---------- Atendimento IA agent: conversations ----------
//
// One Conversation per (restaurant, WhatsApp phone number) thread. State
// durable between inbound messages lives in `draftCart` (the order being
// built) — every message, in and out, is also persisted to `Message` for
// both context-reconstruction on the next turn and a future conversation
// history UI. The AI never writes directly to Customer/Order — see
// src/server/actions/atendimento-ia-conversa.ts's "confirmar_pedido" tool,
// the only place that creates real rows, always re-deriving prices from
// the database.

model Conversation {
  id            String   @id @default(cuid())
  restaurantId  String
  customerId    String?
  phoneNumber   String
  contactName   String?
  /// Per-conversation human-handoff switch — set to false to let a staff
  /// member take over without disconnecting WhatsApp or disabling the
  /// agent for every other conversation.
  aiEnabled     Boolean  @default(true)
  /// The order being built in this conversation (items/address/payment/
  /// phone-to-use) — read and rewritten whole by the agent's tools, never
  /// diffed incrementally, so it can never drift from what was actually
  /// said. Cleared back to null once confirmar_pedido creates the real
  /// Order.
  draftCart     Json?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id])
  messages   Message[]

  @@unique([restaurantId, phoneNumber])
  @@index([restaurantId])
}

enum MessageDirection {
  IN
  OUT
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  content        String
  /// Evolution API's message id, when known — the idempotency key: a
  /// redelivered webhook for the same id is a no-op, never a second reply
  /// or a second order.
  whatsappMessageId String?       @unique
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ---------- Post-order feedback ----------
//
// One Feedback per Order (channel WHATSAPP_IA only, for now — see
// src/server/actions/orders.ts). Scheduled durably in the database the
// moment an order reaches CONCLUIDO (dueAt = now + 3h) so the send survives
// a container restart/deploy; src/instrumentation.ts starts an in-process
// poller (src/server/feedback/scheduler.ts) that picks up due rows. The
// customer's reply is captured by src/server/actions/atendimento-ia-conversa.ts
// before the ordering agent runs, matched by (restaurantId, phoneNumber).

enum FeedbackStatus {
  PENDING   // scheduled, waiting for dueAt
  SENDING   // claimed by a poller run (guards against a double-send race)
  SENT      // sent, waiting for the customer's reply
  RESPONDED // customer replied
  FAILED    // a real send error — never retried automatically
}

model Feedback {
  id                 String         @id @default(cuid())
  restaurantId       String
  orderId            String         @unique
  customerId         String?
  /// Copied from Order.customer.phone at creation time — the number the
  /// feedback request is sent to and the key used to match the reply.
  phoneNumber        String
  status             FeedbackStatus @default(PENDING)
  dueAt              DateTime
  requestSentAt      DateTime?
  responseText       String?        @db.Text
  responseReceivedAt DateTime?
  /// Best-effort 0-10 rating parsed from the customer's free-text reply
  /// (src/lib/feedback-rating.ts) — null whenever no number is mentioned,
  /// which is the common case given the message never explicitly asks for one.
  rating             Int?
  /// Set when a staff member opens /feedbacks and views this row.
  viewedAt           DateTime?
  /// Set when a staff member manually marks this feedback as handled.
  resolvedAt         DateTime?
  createdAt          DateTime       @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id])

  @@index([restaurantId])
  @@index([status, dueAt])
}

// ---------- Recepcionista de IA por telefone (ElevenLabs + Twilio) ----------
//
// One PhoneCall per phone call (not per phone number — a call is a bounded
// session, unlike a WhatsApp Conversation that persists forever). Mirrors
// Conversation/Message's role for the WhatsApp agent: draftCart is the same
// shape/logic, rewritten whole by the tool handlers in
// src/server/actions/telefonia-ia-chamada.ts, never diffed incrementally.
// elevenLabsConversationId is what correlates every tool-webhook call during
// the same live call back to this row (passed back to ElevenLabs as a
// dynamic variable at call start, then echoed in every subsequent tool
// call's headers — see the conversation-initiation webhook route).

enum PhoneCallStatus {
  EM_ANDAMENTO
  CONCLUIDA
  TRANSFERIDA
  FALHA
}

model PhoneCall {
  id                       String          @id @default(cuid())
  restaurantId             String
  callerPhone              String
  calledNumber             String
  elevenLabsConversationId String          @unique
  customerId               String?
  status                   PhoneCallStatus @default(EM_ANDAMENTO)
  draftCart                Json?
  orderId                  String?         @unique
  transferredToHuman       Boolean         @default(false)
  errorNote                String?
  startedAt                DateTime        @default(now())
  endedAt                  DateTime?
  durationSeconds          Int?
  createdAt                DateTime        @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id])
  order      Order?     @relation(fields: [orderId], references: [id])

  @@index([restaurantId])
}

// ---------- Agente de avaliações no Google (Agente 1) ----------
//
// Not the ordering/pedidos product — a separately-branded product sharing
// this backend (see AGENTS.md). One Review per Google review, matched by
// googleReviewId (idempotency, same role as Message.whatsappMessageId).
// sentiment is derived deterministically from the star rating
// (src/lib/review-sentiment.ts), never decided by the AI — only the
// response TEXT is AI-generated; whether to auto-publish or escalate to the
// owner is not.

enum ReviewSentiment {
  POSITIVA
  NEUTRA
  NEGATIVA
}

enum ReviewStatus {
  PENDENTE        // detected, awaiting processing
  RESPONDIDA      // positive/neutral — response generated and published automatically
  AGUARDANDO_DONO // negative — draft sent to the owner via WhatsApp, awaiting approval
  RESOLVIDA       // owner approved (or edited) and the response was published
}

model Review {
  id                String           @id @default(cuid())
  restaurantId      String
  /// Google's own review id — the idempotency key, so re-fetching the same
  /// review on a later poll never creates a duplicate row.
  googleReviewId    String           @unique
  authorName        String
  rating            Int
  text              String?          @db.Text
  sentiment         ReviewSentiment?
  status            ReviewStatus     @default(PENDENTE)
  draftResponse     String?          @db.Text
  publishedResponse String?          @db.Text
  respondedAt       DateTime?
  createdAt         DateTime         @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, status])
}

/// A scheduled post-service review request — durable in the database (same
/// reasoning as Feedback.dueAt) so it survives a container restart/deploy.
/// dueAt is when to send it; sentAt stays null until the poller actually
/// sends it (distinct fields, unlike the original spec's single `sentAt`,
/// which conflated "scheduled for" with "sent at").
model ReviewRequestLog {
  id           String    @id @default(cuid())
  restaurantId String
  /// Optional — a review request can be scheduled manually without tying
  /// it to a specific order.
  orderId      String?   @unique
  phoneNumber  String
  dueAt        DateTime
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([sentAt, dueAt])
}

// ---------- Agente 2 — atendimento genérico de voz (agenda + recuperação de ligação) ----------
//
// PhoneCall (already generic — same model used by the PEDIDO domain) keeps
// serving both domains; only draftCart's shape changes meaning per domain,
// same "JSON, rewritten whole" convention as everywhere else.

model HorarioDisponivel {
  id           String   @id @default(cuid())
  restaurantId String
  dataHora     DateTime
  duracaoMin   Int      @default(30)
  ocupado      Boolean  @default(false)
  /// PhoneCall.id that claimed this slot, if any — not a Prisma relation
  /// (same loose-reference style as ReviewRequestLog.orderId), just enough
  /// to trace which call booked it.
  callId       String?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, dataHora])
}

/// Created whenever a call fails to connect (ElevenLabs' call_initiation_failure
/// webhook) or connects but isn't resolved (analysis.call_successful === false)
/// — the record of "we owe this caller a WhatsApp follow-up", sent immediately
/// via sendAndRecordOutboundMessage, not on a delayed poller like Feedback/
/// ReviewRequestLog (this one fires right away, per the 30s recovery target).
model CallbackRequest {
  id           String   @id @default(cuid())
  restaurantId String
  callerPhone  String
  motivo       String?
  status       String   @default("PENDENTE") // PENDENTE | CONTATADO
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// ---------- Agente 3 — despacho de serviços residenciais emergenciais ----------
//
// Not the ordering/pedidos product, and not the same Order model — a
// separate domain (Chamado) on purpose, so the food-ordering flow already in
// production is never at risk. Conversation/Message are still reused as-is
// for the WhatsApp thread with the customer (Conversation.draftCart holds a
// DraftChamado shape instead of a DraftCart when the tenant is a despacho
// business — same "same JSON column, different shape per domain" convention
// already used by PhoneCall.draftCart across the PEDIDO/ATENDIMENTO_GENERICO
// domains in Agente 2).

enum ChamadoStatus {
  RECEBIDO
  /// Offered to one specific technician, awaiting their accept/decline —
  /// without this intermediate status the timeout/re-offer poller can't tell
  /// "just created, nobody offered yet" apart from "waiting on someone
  /// specific" (not in the original spec — added because the guardrail
  /// "escalate if nobody accepts in X minutes" is meaningless without it).
  OFERTADO
  A_CAMINHO
  EM_ATENDIMENTO
  CONCLUIDO
  CANCELADO
}

enum UrgenciaNivel {
  NORMAL
  URGENTE
  EMERGENCIA
}

model TecnicoDisponibilidade {
  id             String   @id @default(cuid())
  restaurantId   String
  nome           String
  telefone       String
  especialidades String[]
  /// Bairros/regiões atendidas — texto livre no MVP (sem geolocalização real,
  /// conforme o próprio documento reserva pra V2).
  regioes        String[]
  disponivel     Boolean  @default(true)
  createdAt      DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  chamados   Chamado[]  @relation("ChamadoTecnico")

  @@index([restaurantId])
}

model Chamado {
  id           String        @id @default(cuid())
  restaurantId String
  customerId   String?
  /// The technician currently offered the call (status OFERTADO) or already
  /// assigned to it (A_CAMINHO onward) — null before the first offer and
  /// briefly between a decline/timeout and the next offer.
  tecnicoId    String?
  problema     String        @db.Text
  endereco     String
  urgencia     UrgenciaNivel @default(NORMAL)
  status       ChamadoStatus @default(RECEBIDO)
  /// Every technician already offered this call (accepted-then-reassigned
  /// never happens, but declined/timed-out do) — never re-offer to the same
  /// one twice.
  tecnicosOfertados String[] @default([])
  /// Set when status = OFERTADO; the poller (processStalledChamados) re-offers
  /// to the next technician once this passes, via an atomic claim (same
  /// conditional-updateMany idiom as HorarioDisponivel/Feedback) so a
  /// simultaneous accept and timeout can never both win.
  ofertaExpiraEm    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  restaurant Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer?               @relation(fields: [customerId], references: [id])
  tecnico    TecnicoDisponibilidade? @relation("ChamadoTecnico", fields: [tecnicoId], references: [id])
  eventos    ChamadoEvent[]

  @@index([restaurantId])
  @@index([restaurantId, status])
}

/// One row per status transition — same role as OrderEvent for Order.
model ChamadoEvent {
  id        String        @id @default(cuid())
  chamadoId String
  status    ChamadoStatus
  createdAt DateTime      @default(now())

  chamado Chamado @relation(fields: [chamadoId], references: [id], onDelete: Cascade)

  @@index([chamadoId])
}

// ---------- Agente 4 — motor de orçamento automático (cotação) ----------
//
// Not the ordering/despacho product — a separately-branded product sharing
// this backend (see AGENTS.md). Reuses Conversation/Message for the
// WhatsApp thread exactly like Agente 3 does — Conversation.draftCart holds
// a DraftQuote (Record<string variavel, number>) instead of a DraftCart/
// AttendanceDraft when the tenant's whatsappAgentDomain is ORCAMENTO.
//
// The price itself is never decided by the AI — src/server/orcamento/
// pricing.ts's calcularPreco is this agent's priceOrderItems, the sole
// place a Quote's precoCalculado is ever computed, always re-derived from
// PricingRule on the server.

model PricingRule {
  id            String  @id @default(cuid())
  restaurantId  String
  nome          String
  /// Key into Quote.dadosColetados (e.g. "m2", "km", "item_peso"). The
  /// special value "taxa_base" is always applied with quantity 1,
  /// unconditionally — every other variável multiplies valorUnitario by
  /// whatever was collected for it in the conversation.
  variavel      String
  valorUnitario Decimal @db.Decimal(10, 2)
  /// Without a value for this variável, calcularPreco refuses to compute a
  /// price at all (the "nunca chuta um valor — oferece visita técnica"
  /// guardrail from the spec's seção 7) — not in the original doc's model,
  /// added because there was no way to tell "insufficient data" from "zero"
  /// otherwise. An optional rule (e.g. "item extra") simply contributes 0
  /// when not mentioned.
  obrigatoria   Boolean @default(true)
  /// { minimo?: number } — a floor for this line's computed value. Full
  /// tiered/bracket pricing ("faixa", also mentioned in the spec) is a
  /// simplification left out of the MVP, not silently assumed implemented.
  condicao      Json?
  ativo         Boolean @default(true)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

enum QuoteStatus {
  ENVIADO
  ACEITO
  EXPIRADO
  RECUSADO
}

model Quote {
  id             String      @id @default(cuid())
  restaurantId   String
  customerId     String?
  /// Record<string variavel, number> — the structured answers collected
  /// during the conversation, keyed by PricingRule.variavel.
  dadosColetados Json
  precoCalculado Decimal     @db.Decimal(10, 2)
  status         QuoteStatus @default(ENVIADO)
  validoAte      DateTime
  createdAt      DateTime    @default(now())

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer?      @relation(fields: [customerId], references: [id])
  followUp   QuoteFollowUp?

  @@index([restaurantId])
  @@index([restaurantId, status])
}

/// Scheduled the moment a Quote is sent (enviarEm = createdAt + Restaurant.
/// quoteFollowUpDias) — durable in the database, same reasoning as Feedback/
/// ReviewRequestLog, so it survives a container restart/deploy.
model QuoteFollowUp {
  id       String   @id @default(cuid())
  quoteId  String   @unique
  enviarEm DateTime
  enviado  Boolean  @default(false)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

// ---------- Agente 5 — locação autônoma para pequenas imobiliárias ----------
//
// Not the ordering/despacho/orçamento product — a separately-branded
// product sharing this backend (see AGENTS.md). Entirely new data domain
// per the spec's own note (seção 3) — no equivalent Order/Chamado/Quote
// reuse here, only the conversation layer (Conversation/Message, tool-
// calling) is shared. Fatia 1 only this round (agendamento de visita +
// coleta de documentos) — ContratoLocacao/CobrancaRecorrente and the
// approval-related StatusCandidatura values are deliberately not modeled
// yet, per the spec's own explicit instruction to validate fatia 1 with
// real clients before building the rest.

enum StatusCandidatura {
  VISITA_AGENDADA
  DOCUMENTOS_PENDENTES
  EM_ANALISE
}

model Corretor {
  id           String   @id @default(cuid())
  restaurantId String
  nome         String
  telefone     String
  disponivel   Boolean  @default(true)
  createdAt    DateTime @default(now())

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  imoveis      Imovel[]
  candidaturas Candidatura[]

  @@index([restaurantId])
}

model Imovel {
  id           String   @id @default(cuid())
  restaurantId String
  /// The corretor normally responsible for this listing — inherited by a
  /// Candidatura's own corretorId when scheduling a visit, if set; falls
  /// back to any available Corretor otherwise.
  corretorId   String?
  endereco     String
  valorAluguel Decimal  @db.Decimal(10, 2)
  /// URLs pasted manually (e.g. from a portal/Drive the agency already
  /// uses) — no upload/storage infra added this round.
  fotos        String[]
  condicoes    String?  @db.Text
  disponivel   Boolean  @default(true)
  createdAt    DateTime @default(now())

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  corretor     Corretor?     @relation(fields: [corretorId], references: [id])
  candidaturas Candidatura[]

  @@index([restaurantId])
}

model Candidatura {
  id                 String            @id @default(cuid())
  restaurantId       String
  imovelId           String
  customerId         String?
  corretorId         String?
  telefone           String
  status             StatusCandidatura @default(VISITA_AGENDADA)
  visitaAgendadaPara DateTime?
  /// { identidade?: {base64,mimetype,recebidoEm}, comprovanteRenda?: {...} }
  /// — same base64-in-Postgres pattern as Restaurant.menuPdfBase64/
  /// Order.pixProofBase64, captured the same way capturePixProofImage does
  /// (fetchMediaBase64). Fixed order (identidade first, then
  /// comprovanteRenda) — see locacao-ia-conversa.ts.
  documentos         Json?
  createdAt          DateTime          @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  imovel     Imovel     @relation(fields: [imovelId], references: [id])
  customer   Customer?  @relation(fields: [customerId], references: [id])
  corretor   Corretor?  @relation(fields: [corretorId], references: [id])

  @@index([restaurantId])
  @@index([restaurantId, status])
  /// The hard guarantee against double-booking the same corretor at the
  /// exact same instant — enforced by Postgres itself, not just application
  /// logic (a violation is caught in code and reported as "just got taken").
  /// The softer "within N minutes" collision check is an application-level
  /// query before this insert is attempted (see agendar_visita).
  @@unique([corretorId, visitaAgendadaPara])
}
